<!DOCTYPE html>
<html lang="zxx">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="Nuvia Fashion Template">
    <meta name="keywords" content="Nuvia, fashion, clothing, html">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Nuvia</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/bootstrap.min.css" type="text/css">
    <link rel="stylesheet" href="/css/font-awesome.min.css" type="text/css">
    <link rel="stylesheet" href="/css/elegant-icons.css" type="text/css">
    <link rel="stylesheet" href="/css/magnific-popup.css" type="text/css">
    <link rel="stylesheet" href="/css/nice-select.css" type="text/css">
    <link rel="stylesheet" href="/css/owl.carousel.min.css" type="text/css">
    <link rel="stylesheet" href="/css/slicknav.min.css" type="text/css">
    <link rel="stylesheet" href="/css/style.css" type="text/css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 999;
            background: #f3d8de;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        .header__logo {
            padding: 10px 0;
        }

        .header__menu {
            text-align: center;
            padding: 26px 0 25px;
        }

        .header__menu ul li {
            list-style: none;
            display: inline-block;
            margin-right: 45px;
            position: relative;
        }

        .header__menu ul li a {
            font-size: 18px;
            color: #111;
            font-weight: 600;
            padding: 3px 0;
            display: block;
            white-space: nowrap;
            position: relative;
        }

        .header__menu ul li a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 2px;
            background: #f76f8f;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .header__menu ul li:hover a::after,
        .header__menu ul li.active a::after {
            transform: scaleX(1);
        }

        .header__menu li .dropdown {
            position: absolute;
            top: 120%;
            left: 0;
            min-width: 180px;
            background: #f76f8f;
            border-radius: 6px;
            padding: 8px 0;
            display: none;
            z-index: 9999;
        }

        .header__menu li:hover .dropdown {
            display: block;
        }

        .header__menu li .dropdown li {
            display: block;
        }

        .header__menu li .dropdown li a {
            padding: 10px 18px;
            color: #fff;
            font-size: 14px;
        }

        .header__menu li .dropdown li a:hover {
            background: #ffadc5;
        }

        .header__nav__option {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 50px;
            padding: 26px 0 25px;
        }


        .header__nav__option a {
            font-size: 18px;
            color: #000;
            transition: color 0.3s;
        }

        .header__nav__option a:hover {
            color: #f76f8f;
        }

       
        .icon-with-badge {
            position: relative;
        }

        .icon-with-badge .badge {
            position: absolute;
            top: -10px;
            right: -10px;
            background: #f76f8f;
            color: #fff;
            font-size: 10px;
            padding: 4px 6px;
            border-radius: 50%;
            font-weight: bold;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .profile-dropdown {
            position: relative;
        }

        .profile-dropdown .dropdown {
            position: absolute;
            top: 120%;
            left: 50%;
            transform: translateX(-50%);
            min-width: 180px;
            background: #f76f8f;
            border-radius: 6px;
            padding: 8px 0;
            display: none;
            z-index: 9999;
               list-style: none; 
        }

     
.profile-dropdown .dropdown.show {
    display: block;
}

        .profile-dropdown .dropdown li a {
            display: block;
            padding: 10px 18px;
            color: #fff;
            font-size: 14px;
        }

        .profile-dropdown .dropdown li a:hover {
            background: #ffadc5;
        }

        .profile-icon {
            font-size: 18px;
            cursor: pointer;
        }

        .user-name {
            font-size: 14px;
            font-weight: 600;
            color: #f76f8f;
        }

        .hamburger {
            display: none;
            font-size: 22px;
            cursor: pointer;
        }

        
        .mobile-logo {
            display: none;
        }

       
        @media (max-width: 991px) {

            .hamburger {
                display: block;
            }

            .mobile-logo {
                display: block;
            }

            .header__logo {
                display: none;
            }

            .mobile-header {
                justify-content: space-between;
            }

.header__menu {
        position: fixed;
        top: 70px;
        left: 0;
        width: 100%;
        background: #f3d8de;
        display: none;
        padding: 20px 0;
        border-radius: 0 0 12px 12px;
        z-index: 998;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
    }

    .header__menu.show {
        display: block;
    }

    .header__menu ul {
        display: flex;
        flex-direction: column;
        gap: 14px;
        text-align: center;
    }

    .header__menu li {
        display: block;
        margin: 0;
    }

    .header__menu li:hover .dropdown {
        display: none;
    }

    .header__menu .dropdown {
        position: static;
        display: none;
        background: #f76f8f;
        margin-top: 6px;
        border-radius: 6px;
    }

    .header__menu .dropdown.show {
        display: block;
    }

}
    </style>
</head>

<body>
    <header class="header">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-lg-2 d-none d-lg-block">
                    <div class="header__logo">
                        <a href="/">
                            <img src="/img/Nuvia.png" height="50" alt="Nuvia Logo">
                        </a>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <nav class="header__menu">
                        <ul>
                            <li class="<%= activePage === 'home' ? 'active' : '' %>">
                                <a href="/home">Home</a>
                            </li>
                            <li class="<%= activePage === 'shop' ? 'active' : '' %>">
                                <a href="/products">Shop</a>
                            </li>
                            <li class="<%= activePage === 'categories' ? 'active' : '' %>">
                                <a href="#">Categories</a>
                                <ul class="dropdown">
                                    <% if (headerCategories?.length) { %>
                                        <% headerCategories.forEach(category=> { %>
                                            <li>
                                                <a href="/products?category=<%= category.categoryName %>">
                                                    <%= category.categoryName %>
                                                </a>
                                            </li>
                                            <% }) %>
                                                <% } else { %>
                                                    <li><a href="#">No Categories</a></li>
                                                    <% } %>
                                </ul>
                            </li>
                        </ul>
                    </nav>
                </div>

    
                <div class="col-lg-6 col-md-6">
                    <div class="header__nav__option mobile-header">

                        <a href="/" class="mobile-logo">
                            <img src="/img/Nuvia.png" height="38">
                        </a>

                        <a href="/wishlist" class="icon-with-badge">
                            <i class="fas fa-heart"></i>
                            <span id="wishlist-count" class="badge">
                                <%= wishlistCount %>
                            </span>
                        </a>

                        <a href="/cart" class="icon-with-badge">
                            <i class="fas fa-shopping-cart"></i>
                            <span id="cart-count" class="badge">
                                <%= cartCount %>
                            </span>
                        </a>
                        <div class="profile-section">
                            <div class="profile-dropdown">
                                <a href="#" class="profile-icon">
                                    <i class="fa fa-user"></i>
                                </a>
                                <ul class="dropdown">
                                    <li><a href="/userProfile">User Info</a></li>
                                    <li><a href="/user/addresses">Address</a></li>
                                    <li><a href="/order/list">Orders</a></li>
                                    <li><a href="/coupons">Coupon</a></li>
                                    <li><a href="/wallet">Wallet</a></li>
                                    <li class="<%= activePage === 'referral' ? 'active' : '' %>">
                                        <a href="/refer">Refer & Earn</a></li>                                 
                                    <li><a href="/logout">Logout</a></li>
                                </ul>
                            </div>

                            <% if (user) { %>
                                <span class="user-name">
                                    <%= user.name %>
                                </span>
                                <% } %>
                        </div>

                        <div class="hamburger" id="hamburger">
                            <i class="fa fa-bars"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
</body>

</html>
<script>
    function updateHeaderCounts({ cartCount, wishlistCount }) {
        if (cartCount !== undefined) {
            const cartEl = document.getElementById("cart-count");
            if (cartEl) cartEl.innerText = cartCount;
        }

        if (wishlistCount !== undefined) {
            const wishEl = document.getElementById("wishlist-count");
            if (wishEl) wishEl.innerText = wishlistCount;
        }
    }
    const hamburger = document.getElementById("hamburger");
    const menu = document.querySelector(".header__menu");

    hamburger.addEventListener("click", () => {
        menu.classList.toggle("show");
    });

    document.querySelectorAll(".header__menu > ul > li > a").forEach(link => {
        link.addEventListener("click", e => {
            if (window.innerWidth <= 991 && link.nextElementSibling?.classList.contains("dropdown")) {
                e.preventDefault();
                link.nextElementSibling.classList.toggle("show");
            }
        });
    });
    const profileIcon = document.querySelector(".profile-icon");
    const profileDropdown = document.querySelector(".profile-dropdown .dropdown");

    profileIcon.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        profileDropdown.classList.toggle("show");
    });

    document.addEventListener("click", () => {
        profileDropdown.classList.remove("show");
    });
</script>