<%- include("../../views/partials/adminHeader") %>

  <style>
    body {
      font-family: "Poppins", sans-serif;
    }

    .main-content {
      margin-left: 200px;
      padding: 30px;
      margin-top: 50px;
    }

    .dashboard-content {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 20px;
    }

    .card {
      background: #fff;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .chart-container {
      background: #fff;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .charts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 30px;
    }

    canvas {
      width: 100% !important;
      height: 300px !important;
    }
    .filter-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 10px 0 20px;
}

.filter-row label {
  font-weight: 500;
  color: #333;
}

#revenueFilter {
  padding: 8px 14px;
  border-radius: 6px;
  border: 1px solid #ccc;
  font-family: "Poppins", sans-serif;
  cursor: pointer;
  background: #fff;
}

@media (max-width: 992px) {
  .main-content {
    margin-left: 0 !important;
    padding: 20px;
  }

  .dashboard-content > div:first-child {
    flex-direction: column;
    gap: 15px;
  }

  .dashboard-content .card,
  .dashboard-content a.card {
    flex: 1 1 100% !important;
  }

  .charts {
    grid-template-columns: 1fr; 
    gap: 20px;
  }

  canvas {
    height: 250px !important;
  }

  .filter-row {
    flex-direction: column;
    align-items: flex-start;
  }

  #revenueFilter {
    width: 100%;
  }
}

@media (max-width: 576px) {
  .card,
  a.card {
    padding: 15px;
  }

  canvas {
    height: 200px !important;
  }

  .filter-row label {
    font-size: 14px;
  }

  #revenueFilter {
    font-size: 14px;
  }
}
  </style>

  <section class="dashboard-content">
    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
      <div class="card" style="flex: 1;">
        <h3>Total Users</h3>
        <p><strong>
            <%= totalUsers %>
          </strong></p>
      </div>

      <div class="card" style="flex: 1;">
        <h3>Total Orders</h3>
        <p><strong>
            <%= totalOrders %>
          </strong></p>
      </div>


      <div class="card" style="flex: 1;">
        <h3>Total Revenue</h3>
        <p><strong>₹<%= totalRevenue.toLocaleString() %></strong></p>
      </div>
      
<a href="/admin/ledger" class="card" style="flex:1; text-decoration:none; color:inherit;">
  <h3>Ledger</h3>
  <p><strong>View Sales Ledger</strong></p>
</a>

    </div>
<div class="filter-row">
  <label for="revenueFilter">Revenue View:</label>
  <select id="revenueFilter">
    <option value="monthly">Monthly</option>
    <option value="yearly">Yearly</option>
    <option value="weekly">Weekly</option>
  </select>
</div>

    <div class="charts">
      <div class="chart-container">
        <h3>Monthly Revenue (₹)</h3>
        <canvas id="revenueChart"></canvas>
      </div>

      <div class="chart-container">
        <h3>Order Status Distribution</h3>
        <canvas id="orderChart"></canvas>
      </div>
    </div>

<div class="charts">

  <!-- Best Selling Products -->
  <div class="chart-container">
    <h3>Top 10 Best Selling Products</h3>
    <canvas id="productChart"></canvas>
  </div>

  <!-- Best Selling Categories -->
  <div class="chart-container">
    <h3>Top 10 Best Selling Categories</h3>
    <canvas id="categoryChart"></canvas>
  </div>

  <!-- Best Selling Brands -->
  <div class="chart-container">
    <h3>Top 10 Best Selling Brands</h3>
    <canvas id="brandChart"></canvas>
  </div>

</div>

  </section>
  </div>
  <%- include("../partials/adminFooter") %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
(async function () {

  const monthlyRevenue = <%- JSON.stringify(monthlyRevenue) %>;
  const statusCounts = <%- JSON.stringify(statusCounts) %>;

  // ======================
  // Revenue Chart
  // ======================
  const revenueCtx = document.getElementById('revenueChart');
  if (revenueCtx) {
    window.revenueChart = new Chart(revenueCtx, {
      type: 'bar',
      data: {
        labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
        datasets: [{
          label: 'Revenue (₹)',
          data: monthlyRevenue,
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        scales: { y: { beginAtZero: true } }
      }
    });
  }

  // ======================
  // Order Status Pie Chart
  // ======================
  const orderCtx = document.getElementById('orderChart');
  if (orderCtx) {
    new Chart(orderCtx, {
      type: 'pie',
      data: {
        labels: ['Delivered', 'Pending', 'Cancelled'],
        datasets: [{
          data: [
            statusCounts.Delivered,
            statusCounts.Pending,
            statusCounts.Cancelled
          ]
        }]
      }
    });
  }

  // ======================
  // Revenue Filter
  // ======================
  document.getElementById("revenueFilter").addEventListener("change", async (e) => {
    const res = await fetch(`/admin/revenue-stats?filter=${e.target.value}`);
    const result = await res.json();

    revenueChart.data.labels = result.data.map(d =>
      d._id.month ?? d._id.year ?? d._id.week
    );

    revenueChart.data.datasets[0].data =
      result.data.map(d => d.revenue);

    revenueChart.update();
  });

  // ======================
  // Best Selling Products
  // ======================
  const productRes = await fetch("/admin/best-selling-products");
  const productData = await productRes.json();

  new Chart(document.getElementById("productChart"), {
    type: "bar",
    data: {
      labels: productData.map(p => p.productName),
      datasets: [{
        label: "Units Sold",
        data: productData.map(p => p.totalSold)
      }]
    }
  });

  // ======================
  // Best Selling Categories
  // ======================
  const categoryRes = await fetch("/admin/best-selling-categories");
  const categoryData = await categoryRes.json();

  new Chart(document.getElementById("categoryChart"), {
    type: "bar",
    data: {
      labels: categoryData.map(c => c.categoryName),
      datasets: [{
        label: "Units Sold",
        data: categoryData.map(c => c.totalSold)
      }]
    }
  });

  // ======================
  // Best Selling Brands
  // ======================
  const brandRes = await fetch("/admin/best-selling-brands");
  const brandData = await brandRes.json();

  new Chart(document.getElementById("brandChart"), {
    type: "bar",
    data: {
      labels: brandData.map(b => b._id),
      datasets: [{
        label: "Units Sold",
        data: brandData.map(b => b.totalSold)
      }]
    }
  });

})();
</script>
