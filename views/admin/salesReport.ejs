<%- include("../../views/partials/adminHeader", { pageTitle: "Sales Report" }) %>

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }

        .page-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .page-top h3 {
            color: #a04c74;
            font-weight: 600;
        }

        .content {
            margin-top: 80px;
            margin-left: 230px;
            padding: 30px;
            min-height: 100vh;
        }

        .filter-card {
            background: white;
            padding: 20px;
            border-radius: 12px;
        }

        .summary-card {
            border-radius: 10px;
            padding: 15px;
        }

        .pagination-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 15px;
            gap: 8px;
        }

        .page-btn {
            background-color: #ff6fa5;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 5px;
            cursor: pointer;
        }

        .page-btn.active {
            background-color: #a04c74;
            font-weight: 600;
        }

        .page-btn:disabled {
            background-color: #ffc4d6;
            cursor: not-allowed;
        }
@media (max-width: 992px) {
    .content {
        margin-left: 15px;
        margin-top: 60px;
        padding: 20px;
    }

    .page-top {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .filter-card .col-md-3 {
        flex: 1 1 100%;
    }

    .filter-card .col-md-3.d-flex {
        flex-direction: column;
        gap: 10px;
    }

    .summary-card {
        padding: 15px;
        margin-bottom: 15px;
    }

    .table-responsive table {
        font-size: 13px;
    }

    .pagination-wrap {
        flex-wrap: wrap;
        gap: 5px;
    }
}

@media (max-width: 576px) {
    .content {
        margin-left: 10px;
        padding: 15px;
    }

    .page-top h3 {
        font-size: 18px;
    }

    .filter-card .form-label {
        font-size: 14px;
    }

    .filter-card input,
    .filter-card select,
    .filter-card button,
    .filter-card a {
        font-size: 14px;
    }

    .summary-card h6 {
        font-size: 14px;
    }

    .summary-card p {
        font-size: 16px;
    }

    .table-responsive table th,
    .table-responsive table td {
        font-size: 12px;
        padding: 6px;
    }

    .table-responsive {
        padding: 10px;
    }

    .table-responsive table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
    }

    .pagination-wrap {
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 4px;
    }

    .page-btn {
        padding: 4px 8px;
        font-size: 12px;
    }
}
    </style>

    <div class="d-flex">

        <%- include("../../views/partials/adminSidebar") %>

            <div class="content w-100">

                <div class="page-top">
                    <h3 class="mb-4">
                        <i class="bi bi-graph-up-arrow me-2"></i>Sales Report
                    </h3>
                </div>

                <form method="get" action="/admin/salesReport" class="row g-3 mb-4 filter-card shadow-sm">

                    <div class="col-md-3">
                        <label class="form-label"> Filter</label>
                        <select name="filter" class="form-select">
                            <option value="">-- Select --</option>
                            <option value="daily" <%=filters.filter==='daily' ? 'selected' : '' %>>Today</option>
                            <option value="weekly" <%=filters.filter==='weekly' ? 'selected' : '' %>>This Week</option>
                            <option value="monthly" <%=filters.filter==='monthly' ? 'selected' : '' %>>This Month
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">From Date</label>
                        <input type="date" name="fromDate" value="<%= filters.fromDate || '' %>" id="fromDate"
                            class="form-control" onchange="validateDates()">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">To Date</label>
                        <input type="date" name="toDate" value="<%= filters.toDate || '' %>" id="toDate"
                            class="form-control" onchange="validateDates()">
                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button class="btn btn-primary w-100"></i>Generate</button>
                        <a href="/admin/salesReport" class="btn btn-outline-secondary w-100 text-danger">
                            <i class="bi bi-x-circle me-1 "></i>Clear
                        </a>
                    </div>

                </form>

                <div class="d-flex justify-content-end mb-3">
                    <a href="/admin/salesReport/download/pdf?<%= new URLSearchParams(filters).toString() %>"
                        class="btn btn-outline-danger me-2">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
                    </a>

                    <a href="/admin/salesReport/download/excel?<%= new URLSearchParams(filters).toString() %>"
                        class="btn btn-outline-success">
                        <i class="bi bi-file-earmark-excel me-1"></i>Download Excel
                    </a>
                </div>
                <div class="row g-3 mb-4">

                    <div class="col-md d-flex">
                        <div class="card bg-primary text-white summary-card shadow-sm w-100 py-3">
                            <div class="card-body d-flex flex-column justify-content-center text-center">
                                <h6>Total Orders</h6>
                                <p class="mb-0 fs-5">
                                    <%= summary.totalOrderCount %>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md d-flex">
                        <div class="card bg-success text-white summary-card shadow-sm w-100 py-3">
                            <div class="card-body d-flex flex-column justify-content-center text-center">
                                <h6>Total Sales</h6>
                                <p class="mb-0 fs-5">₹ <%= grandTotal.totalAmount.toFixed(2) %>
                                </p>
                            </div>
                        </div>
                    </div>                  

                    <div class="col-md d-flex">
                        <div class="card bg-info text-white summary-card shadow-sm w-100 py-3">
                            <div class="card-body text-center">
                                <h6>Total Tax</h6>
                                <p class="mb-0 fs-5">₹ <%= grandTotal.totalTax.toFixed(2) %>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md d-flex">
                        <div class="card bg-warning text-white summary-card shadow-sm w-100 py-3">
                            <div class="card-body d-flex flex-column justify-content-center text-center">
                                <h6>Total Delivery Charges</h6>
                                <p class="mb-0 fs-5">₹ <%= grandTotal.deliveryCharge.toFixed(2) %>
                                </p>
                            </div>
                        </div>
                    </div>

                     <div class="col-md d-flex">
                        <div class="card bg-danger text-white summary-card shadow-sm w-100 py-3">
                            <div class="card-body d-flex flex-column justify-content-center text-center">
                                <h6>Total Discounts</h6>
                                <p class="mb-0 fs-5">₹ <%= grandTotal.totalDiscount.toFixed(2) %>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md d-flex">
                        <div class="card bg-dark text-white summary-card shadow-sm w-100 py-3">
                            <div class="card-body d-flex flex-column justify-content-center text-center">
                                <h6>Net Revenue</h6>
                                <p class="mb-0 fs-5">₹ <%= grandTotal.finalAmount.toFixed(2) %>
                                </p>
                            </div>
                        </div>
                    </div>

                </div>


                <div class="table-responsive bg-white rounded shadow-sm p-3">
                    <table class="table table-bordered align-middle">
                        <thead class="table-dark">
                            <tr class="text-center">
                                <th>Date</th>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Subtotal</th>                       
                                <th>Tax</th>
                                <th>Delivery</th>
                                 <th>Discount</th>
                                <th>Final</th>

                                <th>Payment</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (orders.length===0) { %>
                                <tr>
                                    <td colspan="8" class="text-center text-muted">
                                        No orders found for the selected period.
                                    </td>
                                </tr>
                                <% } else { %>

                                    <% orders.forEach(order=> { %>
                                        <tr class="text-center">
                                            <td>
                                                <%= order.createdAt.toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <%= order.orderID %>
                                            </td>
                                            <td>
                                                <%= order.user_id?.name || 'Unknown' %>
                                            </td>
                                            <td>₹ <%= order.subtotal.toFixed(2) %></td>

<td>₹ <%= (order.tax || 0).toFixed(2) %></td>
<td>₹ <%= (order.deliveryCharge || 0).toFixed(2) %></td>
<td>₹ <%= (order.couponDiscount || 0).toFixed(2) %></td>
<td>₹ <%= order.totalPrice.toFixed(2) %></td>

                                            <td>
                                                <%= order.paymentMethod %>
                                            </td>
                                        </tr>
                                        <% }) %>

                                            <tr class="text-center fw-bold" style="background-color: #f8f9fa;">
                                                <td colspan="3">Page Totals</td>
                                               <td>₹ <%= summary.totalAmount.toFixed(2) %></td>

<td>₹ <%= summary.totalTax.toFixed(2) %></td>
<td>₹ <%= summary.deliveryCharge.toFixed(2) %></td>
<td>₹ <%= summary.totalDiscount.toFixed(2) %></td>
<td>₹ <%= summary.finalAmount.toFixed(2) %></td>

                                                <td></td>
                                            </tr>

                                            <% } %>
                        </tbody>
                    </table>
                    <div class="pagination-wrap">

                        <% let start=pagination.currentPage - 1; let end=pagination.currentPage; if (start < 1) {
                            start=1; end=2; } if (end> pagination.totalPages) {
                            end = pagination.totalPages;
                            start = pagination.totalPages - 1;
                            }

                            if (start < 1) start=1; %>

                                <% let prevParams=new URLSearchParams({ ...filters, page: pagination.currentPage> 1
                                    ? pagination.currentPage - 1
                                    : 1
                                    });
                                    %>

                                    <% if (pagination.currentPage> 1) { %>
                                        <button class="page-btn"
                                            onclick="window.location.href='?<%= prevParams.toString() %>'">
                                            &laquo; Prev
                                        </button>
                                        <% } else { %>
                                            <button class="page-btn" disabled>&laquo; Prev</button>
                                            <% } %>


                                                <% for (let p=start; p <=end; p++) { let pageParams=new
                                                    URLSearchParams({ ...filters, page: p }); %>
                                                    <button
                                                        class="page-btn <%= pagination.currentPage === p ? 'active' : '' %>"
                                                        onclick="window.location.href='?<%= pageParams.toString() %>'">
                                                        <%= p %>
                                                    </button>
                                                    <% } %>

                                                        <% let nextParams=new URLSearchParams({ ...filters, page:
                                                            pagination.currentPage < pagination.totalPages ?
                                                            pagination.currentPage + 1 : pagination.totalPages }); %>

                                                            <% if (pagination.currentPage < pagination.totalPages) { %>
                                                                <button class="page-btn"
                                                                    onclick="window.location.href='?<%= nextParams.toString() %>'">
                                                                    Next &raquo;
                                                                </button>
                                                                <% } else { %>
                                                                    <button class="page-btn" disabled>Next
                                                                        &raquo;</button>
                                                                    <% } %>

                    </div>


                </div>

            </div>
    </div>


    <%- include("../../views/partials/adminFooter") %>


        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            const filterSelect = document.querySelector('select[name="filter"]');

            filterSelect.addEventListener("change", () => {
                document.getElementById("fromDate").value = "";
                document.getElementById("toDate").value = "";
            });

            function validateDates() {
                const from = document.getElementById("fromDate").value;
                const to = document.getElementById("toDate").value;

                const today = new Date().toISOString().split("T")[0];

                if (from && from > today) {
                    Swal.fire("Invalid Date", "From Date cannot be in the future.", "error");
                    document.getElementById("fromDate").value = "";
                } else if (to && to > today) {
                    Swal.fire("Invalid Date", "To Date cannot be in the future.", "error");
                    document.getElementById("toDate").value = "";
                } else if (from && to && to < from) {
                    Swal.fire("Invalid Range", "To Date cannot be before From Date.", "error");
                    document.getElementById("toDate").value = "";
                }
            }
        </script>