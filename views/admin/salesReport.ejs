<%- include("../../views/partials/adminHeader", { pageTitle: "Sales Report" }) %>
<style>
body {
    font-family: 'Poppins', sans-serif;
    background: #ffe6eb;
}

.content {
    margin-top: 80px;
    margin-left: 220px;
    padding: 10px;
    min-height: 100vh;
}

.summary-card {
    border-radius: 10px;
    padding: 12px;
}

.summary-card h6 {
    font-size: 12px;
    margin-bottom: 4px;
}

.summary-card p {
    font-size: 14px;
    margin: 0;
}

.filter-card {
    background: white;
    padding: 18px;
    border-radius: 12px;
}

.table-responsive {
    max-width: 100%;
    overflow-x: auto;
    padding: 8px;
}

.small-table {
    font-size: 10.5px;
    width: 100%;
}

.small-table th,
.small-table td {
    padding: 6px 8px !important;
    vertical-align: middle;
    white-space: nowrap;
}

.small-table thead th {
    font-size: 10.5px;
    font-weight: 600;
}

.small-table tbody td {
    font-size: 10px;
}

.small-table td.text-end {
    text-align: right;
}

.small-table .badge {
    font-size: 9px;
    padding: 4px 6px;
}

.small-table tr.bg-light td {
    font-weight: 600;
    background: #f1f3f5 !important;
}

.pagination-wrap {
    display: flex;
    justify-content: center;
    gap: 6px;
}

.page-btn {
    background-color: #ff6fa5;
    color: white;
    border: none;
    padding: 5px 10px;
    border-radius: 5px;
    font-size: 12px;
}

@media (max-width: 1200px) {
    .content {
        margin-left: 200px;
    }
}

@media (max-width: 992px) {
    .content {
        margin-left: 15px;
        margin-top: 60px;
        padding: 18px;
    }

    .summary-card {
        padding: 10px;
    }

    .small-table {
        font-size: 12px;
    }
}

@media (max-width: 576px) {
    .content {
        padding: 14px;
    }

    .summary-card h6 {
        font-size: 13px;
    }

    .summary-card p {
        font-size: 15px;
    }

    .small-table th,
    .small-table td {
        padding: 5px !important;
    }
}
</style>
   <div class="d-flex">

        <%- include("../../views/partials/adminSidebar") %>

            <div class="content w-100">

                <div class="page-top">
                    <h3 class="mb-4 p-3">
                        <i class="bi bi-graph-up-arrow me-2"></i>Sales Report
                    </h3>
                </div>

                <form method="get" action="/admin/salesReport" class="row g-3 mb-4 filter-card shadow-sm">

                    <div class="col-md-3">
                        <label class="form-label"> Filter</label>
                        <select name="filter" class="form-select">
                            <option value="">-- Select --</option>
                            <option value="daily" <%=filters.filter==='daily' ? 'selected' : '' %>>Today</option>
                            <option value="weekly" <%=filters.filter==='weekly' ? 'selected' : '' %>>This Week</option>
                            <option value="monthly" <%=filters.filter==='monthly' ? 'selected' : '' %>>This Month
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">From Date</label>
                        <input type="date" name="fromDate" value="<%= filters.fromDate || '' %>" id="fromDate"
                            class="form-control" onchange="validateDates()">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">To Date</label>
                        <input type="date" name="toDate" value="<%= filters.toDate || '' %>" id="toDate"
                            class="form-control" onchange="validateDates()">
                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button class="btn btn-primary w-100"></i>Generate</button>
                        <a href="/admin/salesReport" class="btn btn-outline-secondary w-100 text-danger">
                            <i class="bi bi-x-circle me-1 "></i>Clear
                        </a>
                    </div>

                </form>

                <div class="d-flex justify-content-end mb-3">
                    <a href="/admin/salesReport/download/pdf?<%= new URLSearchParams(filters).toString() %>"
                        class="btn btn-outline-danger me-2">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
                    </a>

                    <a href="/admin/salesReport/download/excel?<%= new URLSearchParams(filters).toString() %>"
                        class="btn btn-outline-success">
                        <i class="bi bi-file-earmark-excel me-1"></i>Download Excel
                    </a>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md">
                        <div class="card bg-primary text-white summary-card text-center">
                            <h6>Total Orders</h6>
                            <p class="fs-5">
                                <%= summary.totalOrderCount %>
                            </p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="card bg-success text-white summary-card text-center">
                            <h6>Total Sales</h6>
                            <p class="fs-5">₹ <%= grandTotal.subtotal.toFixed(2) %>
                            </p>

                        </div>
                    </div>

                    <div class="col-md">
                        <div class="card bg-info text-white summary-card text-center">
                            <h6>Total Tax</h6>
                            <p class="fs-5">₹ <%= grandTotal.totalTax.toFixed(2) %>
                            </p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="card bg-warning text-white summary-card text-center">
                            <h6>Delivery Charges</h6>
                            <p class="fs-5">₹ <%= grandTotal.deliveryCharge.toFixed(2) %>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md">
                        <div class="card bg-danger text-white summary-card text-center">
                            <h6>Total Discounts</h6>
                            <p class="fs-5">₹ <%= grandTotal.totalDiscount.toFixed(2) %>
                            </p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="card bg-success text-white summary-card text-center">
                            <h6>Total Sales (Debit)</h6>
                            <p class="fs-5">₹ <%= grandTotal.totalDebit.toFixed(2) %>
                            </p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="card bg-danger text-white summary-card text-center">
                            <h6>Total Refunds (Credit)</h6>
                            <p class="fs-5">₹ <%= grandTotal.totalCredit.toFixed(2) %>
                            </p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="card bg-dark text-white summary-card text-center">
                            <h6>Net Revenue</h6>
                            <p class="fs-5">₹ <%= grandTotal.netRevenue.toFixed(2) %>
                            </p>
                        </div>
                    </div>
                </div>

<div class="table-responsive bg-white rounded shadow-sm p-2">

                   <table class="table table-sm table-bordered table-hover align-middle small-table">

                        <thead class="table-dark text-center">
                            <tr>
                                <th>Date</th>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Subtotal</th>
                                <th>Tax</th>
                                <th>Delivery</th>
                                <th>Discount</th>
                                <th>Sales(Debit )</th>
                                <th>Refund(Credit)</th>
                                <th>Net</th>
                                <th>Status</th>
                                <th>Payment</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (orders.length===0) { %>
                                <tr>
                                    <td colspan="10" class="text-center text-muted">No orders found</td>
                                </tr>
                                <% } else { %>

                                    <% orders.forEach(order=> { %>
                                        <tr class="text-center">
                                            <td>
                                                <%= order.createdAt.toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <%= order.orderID %>
                                            </td>
                                            <td>
                                                <%= order.user_id?.name || 'Unknown' %>
                                            </td>

                                            <td class="text-end">₹ <%= order.subtotal.toFixed(2) %></td>

                                            <td>₹ <%= (order.tax || 0).toFixed(2) %>
                                            </td>
                                            <td>₹ <%= (order.deliveryCharge || 0).toFixed(2) %>
                                            </td>
                                            <td>₹ <%= (order.couponDiscount || 0).toFixed(2) %>
                                            </td>                         
                                            <td>₹ <%= order.debit.toFixed(2) %>
                                            </td>
                                            <td>₹ <%= order.credit.toFixed(2) %>
                                            </td>
                                            <td>₹ <%= order.net.toFixed(2) %>
                                            </td>
                                            <td>
                                                <span class="badge bg-<%= order.credit > 0 ? 'danger' : 'success' %>">
                                                    <%= order.orderStatus %>
                                                </span>
                                            </td>

                                            <td>
                                                <%= order.paymentMethod %>
                                            </td>
                                        </tr>
                                        <% }) %>

                                            <tr class="fw-bold text-center bg-light">
                                                <td colspan="3">Page Totals</td>

                                                <td>₹ <%= summary.subtotal.toFixed(2) %>
                                                </td>
                                                <td>₹ <%= summary.totalTax.toFixed(2) %>
                                                </td>
                                                <td>₹ <%= summary.deliveryCharge.toFixed(2) %>
                                                </td>
                                                <td>₹ <%= summary.totalDiscount.toFixed(2) %>
                                                </td>
                                             
                                                <td>₹ <%= summary.totalDebit.toFixed(2) %>
                                                </td>
                                                <td>₹ <%= summary.totalCredit.toFixed(2) %>
                                                </td>

                                                <td>₹ <%= summary.netRevenue.toFixed(2) %>
                                                </td>
                                                <td></td>
                                            </tr>


                                            <% } %>
                        </tbody>
                    </table>
                <div class="pagination-wrap">

                        <% let start=pagination.currentPage - 1; let end=pagination.currentPage; if (start < 1) {
                            start=1; end=2; } if (end> pagination.totalPages) {
                            end = pagination.totalPages;
                            start = pagination.totalPages - 1;
                            }

                            if (start < 1) start=1; %>

                                <% let prevParams=new URLSearchParams({ ...filters, page: pagination.currentPage> 1
                                    ? pagination.currentPage - 1
                                    : 1
                                    });
                                    %>

                                    <% if (pagination.currentPage> 1) { %>
                                        <button class="page-btn"
                                            onclick="window.location.href='?<%= prevParams.toString() %>'">
                                            &laquo; Prev
                                        </button>
                                        <% } else { %>
                                            <button class="page-btn" disabled>&laquo; Prev</button>
                                            <% } %>


                                                <% for (let p=start; p <=end; p++) { let pageParams=new
                                                    URLSearchParams({ ...filters, page: p }); %>
                                                    <button
                                                        class="page-btn <%= pagination.currentPage === p ? 'active' : '' %>"
                                                        onclick="window.location.href='?<%= pageParams.toString() %>'">
                                                        <%= p %>
                                                    </button>
                                                    <% } %>

                                                        <% let nextParams=new URLSearchParams({ ...filters, page:
                                                            pagination.currentPage < pagination.totalPages ?
                                                            pagination.currentPage + 1 : pagination.totalPages }); %>

                                                            <% if (pagination.currentPage < pagination.totalPages) { %>
                                                                <button class="page-btn"
                                                                    onclick="window.location.href='?<%= nextParams.toString() %>'">
                                                                    Next &raquo;
                                                                </button>
                                                                <% } else { %>
                                                                    <button class="page-btn" disabled>Next
                                                                        &raquo;</button>
                                                                    <% } %>

                    </div>
                </div>
            </div>
    </div>


    <%- include("../../views/partials/adminFooter") %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            const filterSelect = document.querySelector('select[name="filter"]');

            filterSelect.addEventListener("change", () => {
                document.getElementById("fromDate").value = "";
                document.getElementById("toDate").value = "";
            });

            function validateDates() {
                const from = document.getElementById("fromDate").value;
                const to = document.getElementById("toDate").value;

                const today = new Date().toISOString().split("T")[0];

                if (from && from > today) {
                    Swal.fire("Invalid Date", "From Date cannot be in the future.", "error");
                    document.getElementById("fromDate").value = "";
                } else if (to && to > today) {
                    Swal.fire("Invalid Date", "To Date cannot be in the future.", "error");
                    document.getElementById("toDate").value = "";
                } else if (from && to && to < from) {
                    Swal.fire("Invalid Range", "To Date cannot be before From Date.", "error");
                    document.getElementById("toDate").value = "";
                }
            }
        </script>