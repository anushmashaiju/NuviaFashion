<%- include("../partials/adminHeader", { title: "Orders" }) %>

  <style>
    .page-container {
      margin: 100px 20px 40px 260px;
      font-family: "Poppins", sans-serif;
    }

    .page-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .page-top h3 {
      color: #a04c74;
      font-weight: 600;
    }

    .filters {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
      align-items: center;
    }

    .filters input,
    .filters select {
      padding: 8px 14px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 14px;
      background: #fff;
      min-width: 160px;
    }

    .filters button,
    .filters a {
      padding: 8px 14px;
      font-size: 14px;
      border-radius: 6px;
      text-decoration: none;
    }

    .btn-primary {
      background: #ff3b85;
      color: #fff;
      border: none;
    }

    .btn-secondary {
      background: #ddd;
      color: #333;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
    }

    th {
      background: #ffc4d6;
      padding: 14px;
      text-align: left;
      font-weight: 600;
      color: #a04c74;
      font-size: 15px;
      border-bottom: 1px solid #f4c7d9;
    }

    td {
      padding: 10px 10px;
      font-size: 14px;
      color: #333;
      border-bottom: 1px solid #f5f5f5;
    }

    tr:hover {
      background: #fff8fb;
    }

    select[name="status"] {
      padding: 6px 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      cursor: pointer;
      background: #fff;
    }

    .btn-sm {
      padding: 6px 12px;
    }

    .btn-danger {
      background: #ff6b6b;
      color: #fff;
    }

    .btn-danger:hover {
      background: #e24a4a;
    }


    .pagination-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 15px;
      gap: 8px;
    }

    .page-btn {
      background-color: #ff6fa5;
      color: white;
      border: none;
      padding: 6px 12px;
      border-radius: 5px;
      cursor: pointer;
    }

    .page-btn.active {
      background-color: #a04c74;
      font-weight: 600;
    }

    .page-btn:disabled {
      background-color: #ffc4d6;
      cursor: not-allowed;
    }

    .order-status {
      padding: 6px 12px;
      border: 1px solid #ff3b85;
      border-radius: 6px;
      cursor: pointer;
      background: #fff;
      font-size: 14px;
      font-weight: 500;
      color: #333;
      min-width: 150px;
      transition: 0.2s all ease-in-out;
    }

    .order-status:hover {
      border-color: #ff3b85;
      background: #fff0f6;
    }

    .order-status:disabled {
      color: #aaa;
      cursor: not-allowed;
    }
  </style>

  <div class="page-container">
    <div class="page-top">
      <h3 class="mb-4">
        Orders
      </h3>
    </div>

    <div class="filters">
      <form method="GET">
        <input type="text" name="search" placeholder="Search Order ID / User / Phone" value="<%= search || '' %>" />

        <select name="sort">
          <option value="-createdAt">Newest First</option>
          <option value="createdAt">Oldest First</option>
          <option value="-totalPrice">Price High → Low</option>
          <option value="totalPrice">Price Low → High</option>
        </select>

        <select name="status">
          <option value="">All Status</option>
          <option value="Pending">Pending</option>
          <option value="Shipped">Shipped</option>
          <option value="Out for Delivery">Out for Delivery</option>
          <option value="Delivered">Delivered</option>
          <option value="Cancelled">Cancelled</option>
          <option value="Returned">Returned</option>
           <option value="Return Requested" <%= statusFilter==='Return Requested' ? 'selected' : '' %>>Return Requested</option>
        </select>

        <button type="submit" class="btn btn-primary">Apply</button>
        <a href="/admin/orders" class="btn btn-secondary">Clear</a>
      </form>
    </div>

    <table>
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Customer</th>
          <th>Items</th>
          <th>Date</th>
          <th>Total</th>
          <th>Payment</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(order=> { %>
          <tr>
            <td>#<%= order.orderID %>
            </td>
            <td>
              <%= order.user_id ? order.user_id.name : "Unknown User" %><br>
                <small>
                  <%= order.user_id ? order.user_id.email : "" %>
                </small>
            </td>
            <td>
              <%= order.items.length %> items
            </td>
            <td>
              <%= order.createdAt.toDateString() %>
            </td>
            <td>₹<%= order.totalPrice.toFixed(2) %>
            </td>
            <td>
              <%= order.paymentMethod %><br>

                <small style="color:
    <%= 
      order.paymentStatus === 'Paid' ||
      (order.paymentMethod === 'COD' && 
      (order.orderStatus === 'Delivered' || order.orderStatus === 'Returned'|| order.orderStatus === 'Return Approved' || order.orderStatus === 'Return Rejected'))
      ? 'green' 
      : 'red' 
    %>;
  ">

                  <%= order.paymentStatus==='Paid' || (order.paymentMethod==='COD' && (order.orderStatus==='Delivered'
                    || order.orderStatus==='Returned' || order.orderStatus==='Return Approved' ||
                    order.orderStatus==='Return Rejected' )) ? 'Paid' : order.paymentStatus %>

                </small>
            </td>

            <td>
              <% if(order.orderStatus==='Return Requested' ) { %>
                <button class="btn btn-warning btn-sm return-requested-btn" data-order-id="<%= order.orderID %>">
                  Return Requested
                </button>

                <% } else if(order.orderStatus==='Cancelled' || order.orderStatus==='Returned' ||
                  order.orderStatus==='Return Approved' || order.orderStatus==='Return Rejected' ) { %>

                  <!-- Show Status Text Only -->
                  <span style="color:<%= 
        order.orderStatus.includes('Rejected') ? 'red' : 
        order.orderStatus.includes('Approved') ? 'green' : 
        '#ff4c8b' %>;">
                    <%= order.orderStatus %>
                  </span>

                  <% } else { %>

                    <!-- Normal Select Dropdown -->
                    <select class="order-status" data-id="<%= order._id %>">
                      <% const statuses=['Pending','Shipped','Out for Delivery','Delivered']; %>
                        <% statuses.forEach((status)=> { %>
                          <option value="<%= status %>" <%=order.orderStatus===status ? 'selected' : '' %>>
                            <%= status %>
                          </option>
                          <% }) %>

                            <option value="Cancelled" disabled>Cancelled</option>
                            <option value="Returned" disabled>Returned</option>
                    </select>

                    <% } %>
            </td>


            <td>
              <a href="/admin/orders/<%= order._id %>" class="btn btn-primary btn-sm">View</a>
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>
    <div class="pagination-wrap">

      <!-- Calculate the 2-page sliding window -->
      <% let start=currentPage - 1; let end=currentPage; if (start < 1) { start=1; end=2; } if (end> totalPages) {
        end = totalPages;
        start = totalPages - 1;
        }

        if (start < 1) start=1; %>

          <!-- Previous Button -->
          <% let prevParams=new URLSearchParams({ page: currentPage> 1 ? currentPage - 1 : 1
            });
            if(search) prevParams.set("search", search);
            if(sort) prevParams.set("sort", sort);
            if(statusFilter) prevParams.set("status", statusFilter);
            %>

            <% if(currentPage> 1) { %>
              <button class="page-btn" onclick="window.location.href='?<%= prevParams.toString() %>'">&laquo;
                Prev</button>
              <% } else { %>
                <button class="page-btn" disabled>&laquo; Prev</button>
                <% } %>


                  <!-- Sliding window: (start to end) -->
                  <% for(let p=start; p <=end; p++) { let btnParams=new URLSearchParams({ page: p }); if(search)
                    btnParams.set("search", search); if(sort) btnParams.set("sort", sort); if(statusFilter)
                    btnParams.set("status", statusFilter); %>

                    <button class="page-btn <%= currentPage === p ? 'active' : '' %>"
                      onclick="window.location.href='?<%= btnParams.toString() %>'">
                      <%= p %>
                    </button>

                    <% } %>


                      <!-- Next Button -->
                      <% let nextParams=new URLSearchParams({ page: currentPage < totalPages ? currentPage + 1 :
                        totalPages }); if(search) nextParams.set("search", search); if(sort) nextParams.set("sort",
                        sort); if(statusFilter) nextParams.set("status", statusFilter); %>

                        <% if(currentPage < totalPages) { %>
                          <button class="page-btn" onclick="window.location.href='?<%= nextParams.toString() %>'">Next
                            &raquo;</button>
                          <% } else { %>
                            <button class="page-btn" disabled>Next &raquo;</button>
                            <% } %>

    </div>

  </div>

  <%- include("../partials/adminFooter") %>

    <script>
      document.querySelectorAll(".order-status").forEach(select => {
        select.addEventListener("change", async (e) => {
          const orderId = e.target.dataset.id;
          const status = e.target.value;

          try {
            const res = await fetch(`/admin/orders/update-status/${orderId}`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({ status })
            });

            if (res.ok) {
              Swal.fire({
                icon: 'success',
                title: 'Updated!',
                text: 'Order status has been updated.',
                timer: 1500,
                showConfirmButton: false
              }).then(() => {
                location.reload();
              });
            } else {
              Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: 'Failed to update order status.'
              });
            }
          } catch (err) {
            console.error(err);
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: 'Something went wrong.'
            });
          }
        });
      });


      // Redirect to Return Request Detail Page
      document.querySelectorAll(".return-requested-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const orderID = btn.dataset.orderId; // orderID from button
          window.location.href = `/admin/return-requests/${orderID}`;
        });
      });

    </script>