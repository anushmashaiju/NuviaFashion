<%- include("../partials/adminHeader", { title: "Add Category" }) %>

<style>
  body {
    background-color: #fdf2f5;
    font-family: 'Poppins', sans-serif;
  }

  .admin-layout {
    display: flex;
    margin-top: 60px;
  }

  .admin-main {
    flex: 1;
    margin-left: 230px;
    padding: 30px;
    background-color: #fff;
    min-height: calc(100vh - 80px);
  }

  .card {
    background: #ffe6eb;
    padding: 30px;
    border-radius: 12px;
    max-width: 800px;
    margin: 30px auto;
  }

  h3 {
    color: #a04c74;
    text-align: center;
    margin-bottom: 20px;
    font-weight: 600;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-group label {
    font-weight: 500;
    margin-bottom: 8px;
    display: block;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #f08da4;
    border-radius: 8px;
  }

  .error-text {
    color: red;
    font-size: 14px;
    margin-top: 5px;
  }

  .form-buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 20px;
  }

  .btn-update {
    background-color: #f08da4;
    color: #fff;
    border: none;
    padding: 12px 30px;
    border-radius: 8px;
  }

  .btn-cancel {
    background-color: #ffd4dd;
    padding: 12px 30px;
    border-radius: 8px;
    text-decoration: none;
    color: #a04c74;
  }
 
</style>

<div class="admin-layout">
  <%- include("../partials/adminSidebar") %>

  <main class="admin-main">
    <div class="card">
      <h3>Add Category</h3>

      <form action="/admin/categories/add" method="POST" enctype="multipart/form-data">

   <div class="form-group">
  <label for="categoryName">Category Name</label>
  <input 
    type="text" 
    id="categoryName" 
    name="categoryName"
    value="<%= formData.categoryName || '' %>"
    placeholder="Enter category name"
  >
  <% if (errors && errors.categoryName) { %>
    <p class="error-text"><%= errors.categoryName %></p>
  <% } %>
</div>

<div class="form-group">
  <label for="description">Description</label>
  <textarea 
    id="description" 
    name="description"
    rows="3"
    placeholder="Write a short description..."
  ><%= formData.description || '' %></textarea>
  
  <% if (errors && errors.description) { %>
    <p class="error-text"><%= errors.description %></p>
  <% } %>
</div>
<div class="form-group">
  <label for="categoryOffer">Category Offer (%)</label>
  <input 
    type="number" 
    id="categoryOffer" 
    name="categoryOffer"
    value="<%= formData.categoryOffer || '' %>"
    min="0" max="100"
    placeholder="Enter offer (optional)"
  >
  <% if (errors && errors.categoryOffer) { %>
    <p class="error-text"><%= errors.categoryOffer %></p>
  <% } %>
</div>

<div class="form-group">
  <label for="categoryOfferStart">Offer Start Date</label>
  <input 
    type="date" 
    id="categoryOfferStart" 
    name="categoryOfferStart"
    value="<%= formData.categoryOfferStart || '' %>"
  >
  <% if (errors && errors.categoryOfferStart) { %>
    <p class="error-text"><%= errors.categoryOfferStart %></p>
  <% } %>
</div>

<div class="form-group">
  <label for="categoryOfferEnd">Offer End Date</label>
  <input 
    type="date" 
    id="categoryOfferEnd" 
    name="categoryOfferEnd"
    value="<%= formData.categoryOfferEnd || '' %>"
  >
  <% if (errors && errors.categoryOfferEnd) { %>
    <p class="error-text"><%= errors.categoryOfferEnd %></p>
  <% } %>
</div>


<div class="form-group">
  <label for="thumbnail">Thumbnail Image</label>
<input type="file" id="thumbnail" name="thumbnail" class="image-input" accept="image/*"/>
  <div id="preview" class="d-flex flex-wrap mt-2"></div>
  
  <% if (errors && errors.thumbnail) { %>
    <p class="error-text"><%= errors.thumbnail %></p>
  <% } %>
</div>

        <div class="form-buttons">
          <button type="submit" class="btn-update">Add Category</button>
          <a href="/admin/categories" class="btn-cancel">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>
<script>
  const allowedTypes = [
    "image/jpeg",
    "image/png",
    "image/webp",
    "image/jpg"
  ];

  document.querySelectorAll(".image-input").forEach(input => {
    input.addEventListener("change", function () {
      const file = this.files[0];
      const preview = document.getElementById("preview");

      preview.innerHTML = "";

      if (!file) return;

      if (!allowedTypes.includes(file.type)) {
        Swal.fire({
          icon: "error",
          title: "Invalid File",
          text: "Only JPG, JPEG, PNG, WEBP images are allowed",
          confirmButtonColor: "#e63946",
        });

        this.value = "";
        return;
      }

      const reader = new FileReader();
      reader.onload = (e) => {
        const img = document.createElement("img");
        img.src = e.target.result;
        img.style.width = "150px";
        img.style.height = "150px";
        img.style.objectFit = "contain";
        img.style.border = "1px solid #ccc";
        img.style.borderRadius = "8px";
        preview.appendChild(img);
      };
      reader.readAsDataURL(file);
    });
  });

  const params = new URLSearchParams(window.location.search);

  if (params.get("success") === "true") {
    Swal.fire({
      icon: "success",
      title: "Category added successfully!",
      showConfirmButton: false,
      timer: 2000
    }).then(() => {
      window.location.href = "/admin/categories";
    });
  }
  
  const input = document.getElementById("thumbnail");
  const preview = document.getElementById("preview");

  input.addEventListener("change", function () {
    preview.innerHTML = "";
    if (this.files && this.files[0]) {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = document.createElement("img");
        img.src = e.target.result;
        img.style.width = "150px";
        img.style.height = "150px";
        img.style.objectFit = "contain";
        img.style.border = "1px solid #ccc";
        img.style.borderRadius = "8px";
        preview.appendChild(img);
      };
      reader.readAsDataURL(this.files[0]);
    }
  });

</script>

<%- include("../partials/adminFooter") %>
