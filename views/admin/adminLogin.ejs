<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet">

    <title>Admin Login Page</title>
    <style>
        /* General styles for body */
        body {
            font-family: 'Open Sans', sans-serif;
            margin: 0;
            padding: 0;
            background-image: url('/img/backimg.png');
            background-size: cover;
            background-position: center;
            height: 100vh;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            padding-left: 5%;
        }

        .card {
            width: 100%;
            max-width: 500px;
            padding: 20px;
            background-color: rgba(255, 255, 255, 0.85);
            border-radius: 1rem;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }


        h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 24px;
            color:#f76f8f;
        }

        /* Form styles */
        .form-outline {
            margin-bottom: 20px;
        }

        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 12px;
            font-family: 'Open Sans', sans-serif;
            font-size: 14px;
            border-radius: 5px;
            border: 1px solid #f0ecec;
            box-sizing: border-box;
        }


        input[type="email"]:focus,
        input[type="password"]:focus {
            outline: none;
            border-color:#f76f8f;
        }

        .btn {
            width: 50%;
            padding: 12px;
            background-color:#f76f8f;
            color: #fff;
            border: none;
            font-size: 12px;
            border-radius: 5px;
            cursor: pointer;
            display: block;
            margin: 0 auto;
        }


        .btn:hover {
            background-color: #e1a87c;
        }

        .forgot {
            text-align: center;
            margin: 15px 0;

        }

        .forgot a {
            text-align: center;
            margin: 15px 0;
            font-size: 14px;
            color:#f76f8f;
            text-decoration: none;
        }

        .social-login {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
        }

        .social-login button {
            display: flex;
            align-items: center;
            border: none;
            border-radius: none;
            padding: 8px 12px;
            cursor: pointer;
            font-size: 12px;
            background-color: white;
        }

        .social-login img {
            width: 12px;
            height: 12px;
            margin-right: 8px;
        }

        .register {
            text-align: center;
            font-size: 13px;
            color: #aaa;
        }

        .register a {
            color:#f76f8f;
            text-decoration: none;
        }

        .alert {
            color:#f76f8f;
            text-align: center;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .footer-links {
            text-align: center;
            margin-top: 20px;
        }

        .or {
            text-align: center;
        }
    </style>
</head>

<body>
 
    <div class="card">
        <h2>Admin Login Page</h2>
         <form action="/admin/login" method="POST">
            <div class="form-outline">

                <input type="email" id="email" placeholder="Email" name="email" required />
            </div>

            <div class="form-outline">

                <input type="password" id="password" placeholder="Password" name="password" required />
            </div>

            <div class="pt-1 mb-4">
                <button class="btn" type="submit">Login</button>
            </div>
        </form>

        <!-- Error message -->
        <% if (typeof error !=='undefined' && error) { %>
            <div id="error-message" class="alert">
                <%= error %>
            </div>
            <% } %>

                <div class="forgot">
                    <a href="/forgot-password">Forgot password?</a>
                </div>
                <p class="or">or</p>
                <div class="social-login">
                    <button><img src="https://cdn-icons-png.flaticon.com/512/281/281764.png" alt="Google"> Signup with
                        Google</button>
                    <!-- <button><img src="https://cdn-icons-png.flaticon.com/512/733/733547.png" alt="Facebook"> Signup with
                        Facebook</button> -->
                </div>

                <div class="register">
                    Create an account? <a href="/signup">Register</a>
                </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Automatically hide error after 3 seconds
            setTimeout(() => {
                const errorBox = document.getElementById("error-message");
                if (errorBox) {
                    errorBox.style.display = "none";
                }
            }, 3000);

            // Clear error message when user starts typing
            document.querySelectorAll("input").forEach(input => {
                input.addEventListener("input", () => {
                    const errorBox = document.getElementById("error-message");
                    if (errorBox) {
                        errorBox.style.display = "none";
                    }
                });
            });
        });
    </script>
</body>

</html>