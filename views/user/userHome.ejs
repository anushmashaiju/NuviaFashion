                                <% } %>
            </div>
        </div>
    </section>
    <!-- Top Brands Section End -->

    <%- include("../../views/partials/userFooter.ejs") %>

        <script>
            function startCountdown(durationDays = 3) {
                const endTime = new Date().getTime() + durationDays * 24 * 60 * 60 * 1000;

                function updateCountdown() {
                    const now = new Date().getTime();
                    const distance = endTime - now;

                    if (distance <= 0) {
                        document.getElementById("countdown").innerHTML = "<p>Offer expired!</p>";
                        clearInterval(timerInterval);
                        return;
                    }

                    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                    document.getElementById("days").textContent = days;
                    document.getElementById("hours").textContent = hours;
                    document.getElementById("minutes").textContent = minutes;
                    document.getElementById("seconds").textContent = seconds;
                }

                updateCountdown();
                const timerInterval = setInterval(updateCountdown, 1000);
            }
            startCountdown();

          document.querySelectorAll('.category-link').forEach(link => {
  link.addEventListener('click', async (e) => {
    e.preventDefault();

    document.querySelectorAll('.category-link').forEach(a => a.classList.remove('active'));
    e.target.classList.add('active');

    const categoryId = e.target.dataset.id;

    try {
      const res = await fetch(`/max-offer-product/${categoryId}`);
      const data = await res.json();

      if (data.success && data.product) {
        const p = data.product;

        document.getElementById('offerSection').innerHTML = `
          <div class="row">
            <div class="col-lg-5">
              <div class="categories__hot__deal">
                <img src="${p.images?.length ? p.images[0] : '/img/placeholder.png'}" alt="${p.name}">
                <div class="hot__deal__sticker">
                  <span>Sale Of</span>
                  <h5>${p.activeOffer?.percentage || 0}% OFF</h5>
                </div>
              </div>
            </div>

            <div class="col-lg-6 offset-lg-1">
              <div class="categories__deal__countdown">
                <span>${p.category ? p.category.categoryName : 'Deal of the Week'}</span>
                <h2>${p.name}</h2>
                <p>Exclusive deal for a limited time!</p>
                <div class="categories__deal__countdown__timer" id="countdown">
                  <div class="cd-item"><span id="days">0</span><p>Days</p></div>
                  <div class="cd-item"><span id="hours">0</span><p>Hours</p></div>
                  <div class="cd-item"><span id="minutes">0</span><p>Minutes</p></div>
                  <div class="cd-item"><span id="seconds">0</span><p>Seconds</p></div>
                </div>
                <a href="/product/${p._id}" class="primary-btn">Shop now</a>
              </div>
            </div>
          </div>
        `;

        startCountdown();
      } else {
        document.getElementById('offerSection').innerHTML = `<p>No offers found for this category.</p>`;
      }
    } catch (err) {
      console.error("Error fetching offer:", err);
    }
  });
});


            document.addEventListener("DOMContentLoaded", () => {
    const toast = document.getElementById("wishlist-toast");
    const wishlistCountElement = document.getElementById("wishlist-count");

    document.querySelectorAll(".wishlist-btn").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            e.preventDefault();

            const productId = btn.dataset.productId;

            try {
                const res = await fetch(`/add-to-wishlist/${productId}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" }
                });

                const data = await res.json();

                if (data.success) {
                    // Increment the badge count if it’s added
                    if (!data.already) {
                        let currentCount = parseInt(wishlistCountElement.innerText) || 0;
                        wishlistCountElement.innerText = currentCount + 1;
                    }

                    showToast(data.message || "Added to Wishlist!");
                } else {
                    showToast(data.message || "Something went wrong", true);
                }
            } catch (err) {
                console.error(err);
                showToast("Something went wrong", true);
            }
        });
    });

    function showToast(message, isError = false) {
        toast.innerText = message;
        toast.style.backgroundColor = isError ? "#dc3545" : "#28a745";
        toast.classList.add("show");

        if (toast.hideTimeout) clearTimeout(toast.hideTimeout);

        toast.hideTimeout = setTimeout(() => {
            toast.classList.remove("show");
        }, 2000);
    }
});


            
    document.addEventListener("DOMContentLoaded", () => {
    const cartToast = document.getElementById("cart-toast");
    const cartCountElement = document.getElementById("cart-count");

    function showCartToast(message, isError = false) {
        cartToast.innerText = message;
        cartToast.style.backgroundColor = isError ? "#dc3545" : "#28a745";
        cartToast.classList.add("show");

        if (cartToast.hideTimeout) clearTimeout(cartToast.hideTimeout);

        cartToast.hideTimeout = setTimeout(() => {
            cartToast.classList.remove("show");
        }, 2000);
    }

    document.querySelectorAll(".cart-btn").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            e.preventDefault();
            const productId = btn.dataset.productId;

            try {
                const res = await fetch(`/cart/add-ajax/${productId}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" }
                });

                const data = await res.json();
                showCartToast(data.message || "Added to Cart!", !data.success);

                // ✨ UPDATE CART BADGE INSTANTLY
                if (data.success && data.cartCount !== undefined) {
                    cartCountElement.innerText = data.cartCount;
                }

            } catch (err) {
                console.error(err);
                showCartToast("Something went wrong", true);
            }
        });
    });
});

        </script>