<%- include("../partials/userHeader", { title: "Verify Email",  activePage: "" }) %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
 body {
  font-family: 'Open Sans', sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;  
  margin: 0;
  overflow: hidden;   
}
 .card {
    width: 100%;
    max-width: 400px;
    padding: 35px;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 1rem;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.15);
    text-align: center;
  }

  h2 {
    margin-bottom: 25px;
    font-size: 22px;
    color: #f76f8f;
    font-weight: 600;
  }

  .otp-inputs {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 20px 0 30px;
  }

  .otp-inputs input {
    width: 50px;
    height: 50px;
    text-align: center;
    font-size: 22px;
    border-radius: 8px;
    border: 1px solid #f0ecec;
    background-color: #fff;
    outline: none;
    transition: 0.3s;
  }

  .otp-inputs input:focus {
    border-color: #f76f8f;
    box-shadow: 0 0 5px rgba(247, 111, 143, 0.4);
  }

  .verify-btn {
    width: 55%;
    padding: 12px;
    background-color: #f76f8f;
    color: white;
    border: none;
    font-size: 14px;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.3s;
    margin: 0 auto;
    display: block;
  }

  .verify-btn:hover {
    background-color: #f45c83;
  }

  .resend {
    margin-top: 20px;
    font-size: 14px;
    color: #555;
  }

  .resend button {
    background: none;
    border: none;
    color: #f76f8f;
    font-weight: bold;
    cursor: pointer;
    padding: 0;
    margin-left: 4px;
  }

  .resend button:disabled {
    color: gray;
    cursor: not-allowed;
  }

  #timer {
    display: block;
    margin-top: 5px;
    font-size: 13px;
    color: #777;
  }
</style>

<body>

  <div class="card">
    <h2>Verify Email</h2>

    <p>Enter the OTP sent to <b><%= email %></b></p>

    <form action="/user/edit-profile/verify-otp" method="POST">
      <div class="otp-inputs">
        <input type="text" name="otp1" maxlength="1" required>
        <input type="text" name="otp2" maxlength="1" required>
        <input type="text" name="otp3" maxlength="1" required>
        <input type="text" name="otp4" maxlength="1" required>
      </div>

      <button type="submit" class="verify-btn">Verify</button>
    </form>

    <div class="resend">
      Didn’t receive OTP?
      <form action="/user/edit-profile/resend-otp" method="GET" style="display:inline;">
        <input type="hidden" name="email" value="<%= email %>">
        <button type="submit" id="resendBtn">Resend</button>
      </form>
      <span id="timer">00:59</span>
    </div>
  </div>

<% if (errorMessage) { %>
<script>
  const msg = "<%= errorMessage %>";

  Swal.fire({
    icon: msg.includes("Invalid") || msg.includes("Failed") ? "error" : "success",
    title: msg.includes("Invalid") || msg.includes("Failed") ? "Error" : "Success",
    text: msg,
    backdrop: true,
    allowOutsideClick: true
  });
</script>
<% } %>

<script>
  let timer = 59;
  const timerDisplay = document.getElementById('timer');
  const resendBtn = document.getElementById('resendBtn');
  resendBtn.disabled = true;

  const interval = setInterval(() => {
    const minutes = Math.floor(timer / 60);
    const seconds = timer % 60;
    timerDisplay.textContent =
      `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    timer--;

    if (timer < 0) {
      clearInterval(interval);
      timerDisplay.textContent = "Expired";
      resendBtn.disabled = false;
    }
  }, 1000);

  const inputs = document.querySelectorAll('.otp-inputs input');
  inputs.forEach((input, i) => {
    input.addEventListener('input', () => {
      if (input.value && i < inputs.length - 1) inputs[i + 1].focus();
    });
  });
</script>

