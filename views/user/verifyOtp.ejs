<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Verify OTP</title>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>

    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      width: 100%;
      overflow: hidden;
    }

    body {
      font-family: 'Open Sans', sans-serif;
      background-image: url('/img/backimg.png');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      padding-left: 5%;
      height: 100vh;
      position: fixed; 
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
    }

    .otp-container {
      background: white;
      padding: 40px;
      border-radius: 8px;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
      width: 320px;
      text-align: center;
      z-index: 1;
    }

    .otp-container h2 {
      color: #f76f8f;
      font-size: 20px;
      margin-bottom: 30px;
    }

    .otp-inputs {
      display: flex;
      justify-content: space-between;
      margin: 20px 0;
    }

    .otp-inputs input {
      width: 50px;
      height: 50px;
      text-align: center;
      font-size: 24px;
      border: none;
      border-radius: 8px;
      background: #fcc8e0;
      outline: none;
    }

    .verify-btn {
      background-color: #f76f8f;
      color: white;
      padding: 10px;
      border: none;
      border-radius: 4px;
      width: 60%;
      cursor: pointer;
      font-size: 16px;
      margin-bottom: 10px;
    }

    .resend {
      font-size: 14px;
      color: #555;
      margin-top: 15px;
    }

    .resend button {
      background: none;
      border: none;
      color: #007BFF;
      font-weight: bold;
      cursor: pointer;
      padding: 0;
    }

    .resend button:disabled {
      color: gray;
      cursor: not-allowed;
    }
  </style>
</head>

<body>
  <div class="otp-container">
    <h2>Verify OTP</h2>

    <form id="otpForm" action="/verify-otp" method="POST">
      <input type="hidden" name="email" value="<%= email %>">
      <div class="otp-inputs">
        <input type="text" name="otp1" maxlength="1" required>
        <input type="text" name="otp2" maxlength="1" required>
        <input type="text" name="otp3" maxlength="1" required>
        <input type="text" name="otp4" maxlength="1" required>
      </div>
      <button type="submit" class="verify-btn">Verify</button>
    </form>

    <div class="resend">
      <form action="/resend-otp" method="GET" id="resendForm">
        <button type="submit" id="resendBtn">Resend OTP?</button>
      </form>
      <span id="timer">00:59</span>
    </div>
  </div>

  <% if (errorMessage) { %>
    <script>

      const originalOverflow = document.body.style.overflow;

      Swal.fire({
        icon: "<%= errorMessage.includes('Failed') || errorMessage.includes('Invalid') ? 'error' : 'success' %>",
        title: "<%= errorMessage.includes('Failed') || errorMessage.includes('Invalid') ? 'Error' : 'Success' %>",
        text: "<%= errorMessage %>",
        scrollbarPadding: false,
        backdrop: true,
        allowOutsideClick: true,
        didOpen: () => {

          document.body.style.overflow = originalOverflow;
        },
        didClose: () => {
          document.body.style.overflow = originalOverflow;
        }
      });
    </script>
  <% } %>

  <script>

    let timer = 59;
    const timerDisplay = document.getElementById('timer');
    const resendBtn = document.getElementById('resendBtn');
    resendBtn.disabled = true;

    const interval = setInterval(() => {
      const minutes = Math.floor(timer / 60);
      const seconds = timer % 60;
      timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      timer--;

      if (timer < 0) {
        clearInterval(interval);
        timerDisplay.textContent = "Expired";
        resendBtn.disabled = false;
      }
    }, 1000);

    const inputs = document.querySelectorAll('.otp-inputs input');
    inputs.forEach((input, i) => {
      input.addEventListener('input', () => {
        if (input.value && i < inputs.length - 1) {
          inputs[i + 1].focus();
        }
      });
    });
  </script>
</body>
</html>
