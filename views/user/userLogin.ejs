<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <title>User Login Page</title>
    <style>
        body {
            font-family: 'Open Sans', sans-serif;
            margin: 0;
            padding: 0;
            background-image: url('/img/backimg.png');
            background-size: cover;
            background-position: center;
            height: 100vh;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            padding-left: 5%;
        }

        .card {
            width: 100%;
            max-width: 500px;
            padding: 20px;
            background-color: rgba(255, 255, 255, 0.85);
            border-radius: 1rem;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 24px;
            color: #f76f8f;
        }

        .form-outline {
            margin-bottom: 20px;
            position: relative; 
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            font-size: 18px;
            color: #f76f8f;
            user-select: none;
        }

        input[type="email"],
        input[type="password"],
        input[type="text"]  {
            width: 100%;
            padding: 12px;
            font-size: 14px;
            border-radius: 5px;
            border: 1px solid #f0ecec;
            box-sizing: border-box;
        }

        .password-wrapper input {
            padding-right: 45px;
        }

        input:focus {
            outline: none;
            border-color: #f76f8f;
        }

        .btn {
            width: 50%;
            padding: 12px;
            background-color: #f76f8f;
            color: #fff;
            border: none;
            font-size: 12px;
            border-radius: 5px;
            cursor: pointer;
            display: block;
            margin: 0 auto;
        }

        .btn:hover {
            background-color: #e1a87c;
        }

        .forgot,
        .register {
            text-align: center;
        }

        .forgot a,
        .register a {
            color: #f76f8f;
            text-decoration: none;
        }

        .social-login {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
        }

        .social-login button {
            display: flex;
            align-items: center;
            border: none;
            padding: 8px 12px;
            cursor: pointer;
            font-size: 12px;
            background-color: white;
        }

        .social-login img {
            width: 12px;
            height: 12px;
            margin-right: 8px;
        }

        .error-text {
            color: red;
            font-size: 13px;
            margin-top: 5px;
        }

        .alert {
            text-align: center;
            font-size: 14px;
            color: red;
            margin: 10px 0;
        }
    </style>
</head>

<body>

    <div class="card">
        <h2>User Login Page</h2>

        <form action="/login" method="POST">

            <div class="form-outline">
                <input type="email" id="email" placeholder="Email" name="email">
                <% if (errorField==='email') { %>
                    <p class="error-text"><%= errorMessage %></p>
                <% } %>
            </div>

            <div class="form-outline password-wrapper">
                <input type="password" id="password" placeholder="Password" name="password">
                <span class="toggle-password" onclick="togglePassword('password', 'eyeIcon')">
                    <i id="eyeIcon" class="fa-solid fa-eye fa-xs"></i>
                </span>
                <% if (errorField==='password') { %>
                    <p class="error-text"><%= errorMessage %></p>
                <% } %>
            </div>

            <button class="btn" type="submit">Login</button>
        </form>

        <% if (error && !errorField) { %>
            <div class="alert"><%= error %></div>
        <% } %>

        <div class="forgot">
            <a href="/forgot-password">Forgot password?</a>
        </div>

        <p class="or" style="text-align:center;">or</p>

        <div class="social-login">
            <button type="button" onclick="window.location.href='/auth/google'">
                <img src="https://cdn-icons-png.flaticon.com/512/281/281764.png" alt="Google">
                Signup with Google
            </button>
        </div>

        <div class="register">
            Create an account? <a href="/signup">Register</a>
        </div>
    </div>

    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>

</body>

</html>
