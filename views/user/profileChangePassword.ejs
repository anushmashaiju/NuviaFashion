<%- include("../partials/userHeader", { title: "Change Password" }) %>

<style>
  body {
    font-family: 'Poppins', sans-serif;
    background-color: #fafafa;
  }

  .breadcrumb {
    margin: 100px auto 20px auto;
    width: 90%;
    max-width: 900px;
    font-size: 14px;
    color: #666;
  }

  .breadcrumb a {
    color: #f76f8f;
    text-decoration: none;
    font-weight: 500;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb span {
    color: #333;
  }

  .card {
    width: 100%;
    max-width: 500px;
    margin: 20px auto 80px auto;
    padding: 30px;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  h2 {
    text-align: center;
    margin-bottom: 30px;
    font-size: 24px;
    color: #f76f8f;
  }

  label {
    font-size: 14px;
    color: #555;
    margin-bottom: 6px;
    display: block;
  }

  input[type="password"], input[type="text"] {
    width: 100%;
    padding: 12px;
    font-size: 14px;
    border-radius: 5px;
    border: 1px solid #e0dede;
    margin-bottom: 20px;
    box-sizing: border-box;
  }

  input[type="password"]:focus {
    outline: none;
    border-color: #f76f8f;
    box-shadow: 0 0 5px rgba(247, 111, 143, 0.3);
  }

  button[type="submit"] {
    width: 50%;
    background-color: #f76f8f;
    padding: 12px;
    border: none;
    color: white;
    border-radius: 5px;
    cursor: pointer;
    display: block;
    margin: 0 auto;
  }

  button[type="submit"]:hover {
    background-color: #f45c83;
  }

  .alert {
    text-align: center;
    font-size: 14px;
    margin-bottom: 15px;
  }

  .alert.error {
    color: red;
  }

  .alert.success {
    color: green;
  }
  .password-wrapper {
  position: relative;
  width: 100%;
}

.password-wrapper input {
  padding-right: 40px; 
}

.password-toggle {
  position: absolute;
  right: 12px;
  top: 35%;
  transform: translateY(-50%);
  cursor: pointer;
  color: #888;

}

.password-toggle:hover {
  color: #f76f8f;
}

</style>

<div class="breadcrumb">
  <a href="/home">Home</a> &gt; <a href="/userProfile">My Profile</a> &gt; <span>Change Password</span>
</div>


<div class="card">
  <h2>Change Password</h2>

<% if (errorMessage) { %>
  <p class="alert <%= errorMessage.toLowerCase().includes('success') ? 'success' : 'error' %>">
    <%= errorMessage %>
  </p>
<% } %>


  <form action="/user/change-password" method="POST">
   <label>Current Password</label>
<div class="password-wrapper">
  <input type="password" name="currentPassword" id="currentPassword" required>
  <i class="fa fa-eye password-toggle fa-xs" onclick="togglePassword('currentPassword', this)"></i>
</div>

<label>New Password</label>
<div class="password-wrapper">
  <input type="password" name="newPassword" id="newPassword" required>
  <i class="fa fa-eye password-toggle fa-xs" onclick="togglePassword('newPassword', this)"></i>
</div>

<label>Confirm Password</label>
<div class="password-wrapper">
  <input type="password" name="confirmPassword" id="confirmPassword" required>
  <i class="fa fa-eye password-toggle fa-xs" onclick="togglePassword('confirmPassword', this)"></i>
</div>

    <button type="submit">Update Password</button>
</form>

<% if (errorMessage) { %>
  <p style="color:red;"><%= errorMessage %></p>
<% } %>

<% if (passwordSuccess) { %>
  <p style="color:green;"><%= passwordSuccess %></p>
<% } %>
</div>

<%- include("../partials/userFooter") %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const alertBox = document.querySelector(".alert");
    if (alertBox) {
      setTimeout(() => { alertBox.style.display = "none"; }, 3000);
    }
  });

   function togglePassword(fieldId, icon) {
    const field = document.getElementById(fieldId);
    if (field.type === "password") {
      field.type = "text";
      icon.classList.remove("fa-eye");
      icon.classList.add("fa-eye-slash");
    } else {
      field.type = "password";
      icon.classList.remove("fa-eye-slash");
      icon.classList.add("fa-eye");
    }
  }
</script>
