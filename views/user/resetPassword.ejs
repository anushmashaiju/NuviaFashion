<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Open Sans', sans-serif;
      margin: 0;
      padding: 0;
      background-image: url('/img/backimg.png');
      background-size: cover;
      background-position: center;
      height: 100vh;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      padding-left: 5%;
    }

    .card {
      width: 100%;
      max-width: 500px;
      padding: 30px;
      background-color: rgba(255, 255, 255, 0.85);
      border-radius: 1rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    h2 {
      text-align: center;
      margin-bottom: 30px;
      font-size: 24px;
      color: #f76f8f;
    }

    label {
      font-size: 14px;
      color: #555;
      margin-bottom: 6px;
      display: block;
    }

    input[type="password"] {
      width: 100%;
      padding: 12px;
      font-size: 14px;
      border-radius: 5px;
      border: 1px solid #f0ecec;
      margin-bottom: 5px;
    }

    .error-input {
      border-color: #ff4d4d !important;
    }

    .error-text {
      color: #ff4d4d;
      font-size: 13px;
      margin-bottom: 15px;
    }

    .btn-reset {
      width: 50%;
      padding: 12px;
      background-color: #f76f8f;
      color: #fff;
      border: none;
      font-size: 12px;
      border-radius: 5px;
      cursor: pointer;
      display: block;
      margin: 0 auto;
    }

    .btn-reset:hover {
      background-color: #f45c83;
    }

    .back-login {
      text-align: center;
      margin-top: 20px;
      font-size: 13px;
    }

    .back-login a {
      color: #f76f8f;
      text-decoration: none;
      font-weight: 500;
    }
  </style>
</head>

<body>
  <div class="card">
    <h2>Reset Password</h2>

    <form action="/reset-password" method="POST">
      <input type="hidden" name="email" value="<%= email %>">

      <input 
        type="password" 
        id="password" 
        name="password" 
        placeholder="Enter new password"
        class="<%= errorField === 'password' ? 'error-input' : '' %>"
      >
      <% if (errorField === 'password') { %>
        <p class="error-text"><%= errorMessage %></p>
      <% } %>
  
      <input 
        type="password" 
        id="confirmPassword" 
        name="confirmPassword" 
        placeholder="Confirm your password"
        class="<%= errorField === 'confirmPassword' ? 'error-input' : '' %>"
      >
      <% if (errorField === 'confirmPassword') { %>
        <p class="error-text"><%= errorMessage %></p>
      <% } %>

      <button type="submit" class="btn-reset">Reset Password</button>
    </form>

    <div class="back-login">
      <a href="/login">Back to Login</a>
    </div>
  </div>

</body>
</html>
