<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Signup Page</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <style>
    body {
      font-family: 'Open Sans', sans-serif;
      margin: 0;
      padding: 0;
      background-image: url('/img/backimg.png');
      background-size: cover;
      background-position: center;
      height: 100vh;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      padding-left: 5%;
    }

    .card {
      width: 100%;
      max-width: 500px;
      padding: 20px;
      background-color: rgba(255, 255, 255, 0.85);
      border-radius: 1rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    h2 {
      text-align: center;
      margin-bottom: 30px;
      font-size: 24px;
      color: #f76f8f;
    }

    .form-group {
      margin-bottom: 20px;
      position: relative; 
    }

    input[type="text"],
    input[type="email"],
    input[type="password"] {
      width: 100%;
      padding: 12px;
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      border-radius: 5px;
      border: 1px solid #f0ecec;
      box-sizing: border-box;
    }

    input:focus {
      outline: none;
      border-color: #f76f8f;
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      font-size: 18px;
      color: #f76f8f;
      user-select: none;
    }

    .btn {
      width: 50%;
      padding: 12px;
      background-color: #f76f8f;
      color: #fff;
      border: none;
      font-size: 14px;
      border-radius: 5px;
      cursor: pointer;
      display: block;
      margin: 0 auto;
    }

    .btn:hover {
      background-color: #e1a87c;
    }

    .alert {
      color: red;
      font-size: 14px;
      margin-top: -15px;
      margin-bottom: 10px;
    }

    .login-link {
      text-align: center;
      font-size: 13px;
      color: #aaa;
    }

    .login-link a {
      color: #f76f8f;
      text-decoration: none;
    }

    .social-login {
      display: flex;
      justify-content: space-around;
      margin: 20px 0;
    }

    .social-login button {
      display: flex;
      align-items: center;
      border: none;
      padding: 8px 12px;
      cursor: pointer;
      font-size: 12px;
      background-color: white;
    }

    .social-login img {
      width: 12px;
      height: 12px;
      margin-right: 8px;
    }

    .or {
      text-align: center;
    }

    .error-text {
      color: red;
      font-size: 13px;
      margin-top: 5px;
    }

  </style>
</head>

<body>
  <div class="card">
    <h2>Create Account</h2>

    <% if (errorMessage && !errorField) { %>
      <div class="alert alert-danger">
        <%= errorMessage %>
      </div>
    <% } %>

    <form action="/signup" method="POST">

      <div class="form-group">
        <input type="text" name="name" placeholder="Enter Name" value="<%= name %>"
          class="<%= errorField === 'name' ? 'input-error' : '' %>">
        <% if (errorField==='name' ) { %>
          <p class="error-text"><%= errorMessage %></p>
        <% } %>
      </div>

      <div class="form-group">
        <input type="email" name="email" placeholder="Enter Email" value="<%= email %>"
          class="<%= errorField === 'email' ? 'input-error' : '' %>">
        <% if (errorField==='email' ) { %>
          <p class="error-text"><%= errorMessage %></p>
        <% } %>
      </div>

      <div class="form-group">
        <input type="text" name="mobile" placeholder="Enter Mobile number" value="<%= mobile %>"
          class="<%= errorField === 'mobile' ? 'input-error' : '' %>">
        <% if (errorField==='mobile' ) { %>
          <p class="error-text"><%= errorMessage %></p>
        <% } %>
      </div>

      <div class="form-group">
        <input type="password" id="password" name="password" placeholder="Enter Password"
          class="<%= errorField === 'password' ? 'input-error' : '' %>">
        <span class="toggle-password" onclick="togglePassword('password', 'eyeIcon')">
          <i id="eyeIcon" class="fa-solid fa-eye fa-xs"></i>
        </span>
        <% if (errorField==='password' ) { %>
          <p class="error-text"><%= errorMessage %></p>
        <% } %>
      </div>

      <div class="form-group">
        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password"
          class="<%= errorField === 'confirmPassword' ? 'input-error' : '' %>">
        <span class="toggle-password" onclick="togglePassword('confirmPassword', 'eyeIconConfirm')">
          <i id="eyeIconConfirm" class="fa-solid fa-eye fa-xs"></i>
        </span>
        <% if (errorField==='confirmPassword' ) { %>
          <p class="error-text"><%= errorMessage %></p>
        <% } %>
      </div>

      <button class="btn" type="submit">Sign Up</button>
    </form>

    <p class="or">or</p>

    <div class="social-login">
      <button type="button" onclick="window.location.href='/auth/google'" class="btn-google">
        <img src="https://cdn-icons-png.flaticon.com/512/281/281764.png" alt="Google">
        Signup with Google
      </button>
    </div>

    <div class="login-link">
      Already have an account? <a href="/login">Login</a>
    </div>

  </div>

  <script>
    function togglePassword(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);

      if (input.type === "password") {
        input.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
      } else {
        input.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
      }
    }
  </script>
</body>

</html>
