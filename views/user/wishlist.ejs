    // function moveToCart(productId, variantId = null) {
    //   fetch(`/cart/add-ajax/${productId}`, {
    //     method: 'POST',
    //     credentials: "include",
    //     headers: { 'Content-Type': 'application/json' },
    //     body: JSON.stringify({ variantId })
    //   })
    //     .then(res => res.json())
    //     .then(data => {
    //       showToast(data.message);
    //       if (data.success) removeWishlist(productId, variantId);
    //     });
    // }
function moveToCart(productId, variantId = null) {
  fetch(`/cart/add-ajax/${productId}`, {
    method: 'POST',
    credentials: "include",
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ variantId })
  })
    .then(res => res.json())
    .then(data => {
      showToast(data.message);

      if (data.success) {
        removeWishlist(productId, variantId);

        updateHeaderCounts({
          cartCount: data.cartCount,
          wishlistCount: data.wishlistCount
        });
      }
    });
}


  </script>

  <%- include("../partials/userFooter") %>