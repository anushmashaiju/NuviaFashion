<%- include("../partials/userHeader", { title: "My Wishlist" }) %>
  <div id="toastBox">
  </div>

  <style>
    body {
      font-family: "Poppins", sans-serif;
      background-color: #fafafa;
    }

    .wishlist-container {
      max-width: 1100px;
      margin: 120px auto 50px auto;
      background: #fff;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }
.wishlist-container h2{
  margin-bottom: 25px; 
  color: #030303; 
  font-weight: 600;
  text-align: center; 
}
    .wishlist-item {
      display: grid;
      grid-template-columns: 120px 1fr 160px;
      gap: 20px;
      padding: 20px 0;
      border-bottom: 1px solid #eee;
      align-items: center;
    }

    .wishlist-item img {
      width: 120px;
      height: 120px;
      object-fit: contain;
      border-radius: 10px;
      background: #f8f8f8;
    }

    .wishlist-item h4 {
      margin: 0;
      font-size: 18px;
      color: #333;
    }

    .wishlist-item p {
      margin: 5px 0;
      color: #777;
      font-size: 14px;
    }

    .wishlist-actions button {
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      border: none;
      margin-bottom: 10px;
      cursor: pointer;
      font-weight: 500;
      transition: 0.3s;
    }

    .btn-cart {
      background-color: #f76f8f;
      color: #fff;
    }

    .btn-cart:hover {
      background-color: #e2577a;
    }

    .btn-remove {
      background-color: #fff;
      border: 2px solid #f76f8f;
      color: #f76f8f;
    }

    .btn-remove:hover {
      background-color: #f76f8f;
      color: white;
    }

    .empty-box {
      text-align: center;
      padding: 50px 0;
    }

    .empty-box img {
      width: 200px;
      margin-bottom: 20px;
    }

    .empty-box a {
      background: #f76f8f;
      color: white;
      padding: 12px 20px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 500;
      margin-top: 20px;
      display: inline-block;
    }

    .empty-box a:hover {
      background-color: #e2577a;
    }

    #toastBox {
      position: fixed;
      bottom: 20px;
      right: -300px;
      background-color: #000;
      color: white;
      padding: 12px 20px;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
      z-index: 9999;
      opacity: 0;
      transition: transform 0.5s ease, opacity 0.5s ease;
    }

    #toastBox.show {
      transform: translateX(-320px);
      opacity: 1;
    }
  </style>

 <div class="wishlist-container">
  <h2>My Wishlist</h2>
  <hr>

  <% if (!wishlist || wishlist.products.length === 0) { %>
    <div class="empty-box">
      <img src="/img/empty-wishlist.png" alt="">
      <h3>Your wishlist is empty</h3>
      <a href="/products">Continue Shopping</a>
    </div>

  <% } else { %>

    <% wishlist.products.forEach(item => { %>
      <% if (item.productId) { %>

       <%
  const product = item.productId;

  const variant = item.variantId
    ? product.variants.find(v =>
        v._id.toString() === item.variantId.toString()
      )
    : null;

  const image = variant?.image || product.images[0];

  const price = variant?.finalPrice
    || variant?.price
    || product.finalPrice
    || product.price;

  const stock = typeof variant?.stock === "number"
    ? variant.stock
    : product.stock;
%>

        <div class="wishlist-item" id="wish-<%= product._id %>">

          <img src="<%= image %>" alt="">

          <div>
            <h4><%= product.name %></h4>

            <% if (variant) { %>
              <p>Color: <%= variant.color %> | Size: <%= variant.size %></p>
            <% } %>

            <p>₹ <%= price %></p>

            <p style="color:<%= stock > 0 ? 'green' : 'red' %>;">
              <%= stock > 0 ? 'In Stock' : 'Out of Stock' %>
            </p>
          </div>

          <div class="wishlist-actions">
            <button class="btn-cart"
              onclick="moveToCart('<%= product._id %>', '<%= variant ? variant._id : "" %>')">
              Move to Cart
            </button>

            <button class="btn-remove"
              onclick="removeWishlist('<%= product._id %>', '<%= variant ? variant._id : "" %>')">
              Remove
            </button>
          </div>

        </div>

      <% } %>   
    <% }) %>    

  <% } %>        

</div>


  <script>
    function showToast(message, error = false) {
      const toast = document.getElementById("toastBox");

      toast.innerText = message;
      toast.style.backgroundColor = error ? "#e2577a" : "#28a745";

      toast.classList.add("show");

      if (toast.hideTimeout) clearTimeout(toast.hideTimeout);

      toast.hideTimeout = setTimeout(() => {
        toast.classList.remove("show");
      }, 2000);
    }
function removeWishlist(productId, variantId = null) {
  fetch('/wishlist/remove', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ productId, variantId })
  })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        document.getElementById("wish-" + productId).remove();

        updateHeaderCounts({
          wishlistCount: data.count
        });
      }
    });
}

